# NOTE: CHANGE THESE VALUES YOUR INSTALLATION. THESE ARE DEFAULTS AND SHOULD NEVER BE USED IN A REAL SETTING

# DB Settings
# NOTE: The DB_USER will be a user that only has permissions to modify data in the openchatroom DB
DB_NAME=openchatroom
DB_PORT=3306
DB_USER=ocr_dev
DB_PASSWORD=password
DB_ROOT_PASSWORD=password
DB_INIT_SQL_PATH=./MySQLQueries/init/

# APP Settings
APP_PORT=5443
CERT_PATH=./certs/openchatroom.pfx
CERT_PASSWORD=MySecretPassword
JWT_KEY_PATH=./certs/jwt-key.txt
MESSAGE_KEY_PATH=./certs/message-key.txt

MessageCountPerRequest=50
ChannelCountPerRequest=50
JwtAuthority=https://localhost:5443
JwtAudience=https://localhost:5443
JwtIssuer=https://localhost:5443
JwtLifetimeMinutes=15
